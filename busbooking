<!DOCTYPE html>
<html lang="en">
<head>
  <style>
    header{
      background: color #00b4d8;
    }
    .form-group{
      width: 450px;
      margin: 50px;
      padding: 25px;
      background-color: rgb(171, 242, 171);
      border: 2px solid #333;
      border-radius: 10px;
    }

    input{
      width: 100%;
      padding: 10px;
      box-sizing: border-box;
      border: 1px solid #aaa;
      border-radius: 5px;
      background-color: #d2f5b4;
    }
    button{
      border-radius: 10px;
      align-items: center;
    }
    table{
      background-color: rgb(171, 242, 171);
    }
     body {
          background-color : darkgoldenrod ;
     }
     h1 {
        text-align: center;
        font-size: x-large;
        font-weight: bold;
     }
     h2 {
      text-align: center;
     }
     p{
      text-align: center;
      font-style: italic;
      font-size: 15px;
      text-decoration-color: darkblue;
      font-weight: bolder;
     }
  </style>
  <title>WD PROJECT TK</title>
</head>
<body>

<header>
  <h1>TK AND TINASHE TRAVELS</h1>
  <p>Book your bus tickets quickly and easily</p>
</header>

<nav>
  <a href="#buses">Our Buses</a> |
  <a href="#schedule">Available Buses</a> |
  <a href="#booking">Book a Ticket</a>
</nav>

<hr>

<!-- Bus Images -->
<section id="buses">
  <h2>Our Buses</h2>
  <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=400" alt="Bus on the road">
  <img src="https://images.unsplash.com/photo-1570125909232-eb263c188f7e?w=400" alt="Bus at station">
  <img src="https://images.unsplash.com/photo-1570125909517-53cb21c89ff2?w=400" alt="Bus interior seats">
</section>

<hr>

<!-- Bus Schedule Table -->
 <div class="form-group">
<section id="schedule">
  <h2>Available Buses</h2>
  <table border="1" cellpadding="8" cellspacing="0">
    <thead>
      <tr>
        <th>Bus No.</th>
        <th>Source</th>
        <th>Destination</th>
        <th>Departure</th>
        <th>Price</th>
        <th>Route / Map</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>B101</td>
        <td>Harare</td>
        <td>Bulawayo</td>
        <td>06:00 AM</td>
        <td>$15</td>
        <td><a href="https://www.google.com/maps/dir/Harare/Bulawayo" target="_blank">View Route</a></td>
      </tr>
      <tr>
        <td>B102</td>
        <td>Harare</td>
        <td>Mutare</td>
        <td>08:30 AM</td>
        <td>$10</td>
        <td><a href="https://www.google.com/maps/dir/Harare/Mutare" target="_blank">View Route</a></td>
      </tr>
      <tr>
        <td>B103</td>
        <td>Bulawayo</td>
        <td>Victoria Falls</td>
        <td>10:00 AM</td>
        <td>$20</td>
        <td><a href="https://www.google.com/maps/dir/Bulawayo/Victoria+Falls" target="_blank">View Route</a></td>
      </tr>
      <tr>
        <td>B104</td>
        <td>Gweru</td>
        <td>Harare</td>
        <td>02:00 PM</td>
        <td>$12</td>
        <td><a href="https://www.google.com/maps/dir/Gweru/Harare" target="_blank">View Route</a></td>
      </tr>
    </tbody>
  </table>
</section>
 </div>

<hr>

<!-- Booking Form -->
 <div class="form-group">
<section id="booking">
  <h2>Book a Ticket</h2>
  <form>
    <label for="name">Passenger Name</label><br>
    <input type="text" id="name" required placeholder="Enter your full name"><br><br>

    <label for="source">Source</label><br>
    <input type="text" id="source" required placeholder="e.g. Harare"><br><br>

    <label for="destination">Destination</label><br>
    <input type="text" id="destination" required placeholder="e.g. Bulawayo"><br><br>

    <label for="date">Travel Date</label><br>
    <input type="date" id="date" required><br><br>

    <label for="seats">Number of Seats</label><br>
    <input type="number" id="seats" min="1" max="10" value="1" required><br><br>

    <label for="mobile">Mobile Number</label><br>
    <input type="tel" id="mobile" required placeholder="e.g. 0771234567"><br><br>

    <button type="submit">Book Ticket</button>
  </form>
</section>
</div>
<hr>

<footer>
  <p>&copy; 2026 TK AND TINASHE TRAVELS.</p>
</footer>

</body>
</html>

